APP_NAME=职达简历
APP_ENV=production
APP_BASE_PATH=/resume-ai
# Configure this after binding a formal HTTPS domain.  It powers secure links
# and readiness reporting; do not use a bare HTTP IP address for public release.
PUBLIC_BASE_URL=https://resume.example.com
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_HOURS=24
AUTH_COOKIE_NAME=zhiday_session
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# SenseNova OpenAI-compatible API
SENSENOVA_BASE_URL=https://token.sensenova.cn/v1
SENSENOVA_API_KEY=sk-replace-me
SENSENOVA_PREPROCESS_MODEL=sensenova-6.7-flash-lite
SENSENOVA_REWRITE_MODEL=deepseek-v4-flash
SENSENOVA_IMAGE_MODEL=sensenova-u1-fast
SENSENOVA_DESIGN_MODEL=sensenova-6.7-flash-lite
SENSENOVA_MAX_CONCURRENCY=2
SENSENOVA_MIN_INTERVAL_SECONDS=1.2
SENSENOVA_MAX_RETRIES=2
SENSENOVA_REQUEST_TIMEOUT_SECONDS=55
AI_MOCK=false

# Alibaba Cloud Phone Number Verification Service (Dypnsapi) SMS verification
ALIYUN_ACCESS_KEY_ID=replace-me
ALIYUN_ACCESS_KEY_SECRET=replace-me
ALIYUN_DYPNS_REGION_ID=cn-hangzhou
ALIYUN_DYPNS_ENDPOINT=https://dypnsapi.aliyuncs.com/
SMS_SIGN_NAME=replace-with-console-sign-name
SMS_TEMPLATE_CODE=
SMS_TEMPLATE_CODE_REGISTER=100001
SMS_TEMPLATE_CODE_LOGIN=100001
SMS_TEMPLATE_CODE_RESET_PASSWORD=100003
SMS_TEMPLATE_CODE_CHANGE_PHONE=100002
SMS_SCHEME_NAME=jd-resume-ai
SMS_CODE_VALID_MINUTES=5
SMS_SEND_COOLDOWN_SECONDS=60
SMS_DAILY_LIMIT_PER_PHONE=10
SMS_REQUEST_TIMEOUT_SECONDS=10
SMS_MOCK=false
SMS_MOCK_CODE=123456

# Volcengine TOS via its S3-compatible endpoint. Use three distinct buckets.
STORAGE_BACKEND=tos
TOS_ACCESS_KEY_ID=replace-me
TOS_SECRET_ACCESS_KEY=replace-me
TOS_REGION=cn-beijing
TOS_S3_ENDPOINT=https://tos-s3-cn-beijing.volces.com
TOS_PUBLIC_ENDPOINT=tos-cn-beijing.volces.com
TOS_BUCKET_A=replace-system-data-bucket
TOS_BUCKET_B=replace-resume-files-bucket
TOS_BUCKET_C=replace-image-assets-bucket
TOS_PREFIX=jd-resume-ai
TOS_PRESIGN_SECONDS=3600
TOS_WARNING_BYTES=5368709120
TOS_WARNING_REQUESTS=500000
TOS_WARNING_EGRESS_BYTES=5368709120

# Runtime port is selected automatically when unset.
PORT=
PORT_SCAN_START=8100
PORT_SCAN_END=8999
TRUSTED_HOSTS=resume.example.com
# Same-origin Web/API calls do not need CORS. Add only trusted front-end origins,
# separated by commas, when a separate domain is intentionally used.
CORS_ALLOWED_ORIGINS=
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=12
TASK_RATE_LIMIT_PER_HOUR=30
SECURITY_HEADERS_ENABLED=true

# PostgreSQL stores all user, task, audit and generation metadata. TOS only
# stores binary artifacts (uploads, avatars, Word/PDF files and APKs).
DATABASE_URL=postgresql://jdresume:replace-with-a-strong-database-password@127.0.0.1:5432/jdresume

# Redis/RQ makes OCR, JD parsing and generation restart-safe and retryable.
REDIS_URL=redis://127.0.0.1:6379/0
TASK_QUEUE_ENABLED=true
TASK_QUEUE_NAME=resume-ai
