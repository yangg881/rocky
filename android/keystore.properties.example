# Copy to android/keystore.properties (NEVER commit the real file) and fill in.
# Generate a release keystore once and back it up offline in two places —
# losing it means you can never publish a signed upgrade again.
#
#   keytool -genkeypair -v -keystore zhiday-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias zhiday
#
storeFile=/absolute/path/to/zhiday-release.jks
storePassword=CHANGE_ME
keyAlias=zhiday
keyPassword=CHANGE_ME
